# Python
pipeline/.venv/
pipeline/**/__pycache__/
pipeline/*.egg-info/
pipeline/build/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Cached indexes, contextual prefixes, and extractions. Expensive to regenerate,
# but derived data — rebuildable with --rebuild-index.
pipeline/.index-cache/

# Precomputed results are committed: they are the deployed site's entire data
# source, and shipping them means a fresh clone shows real measurements without
# spending anything. Every committed result was produced by a real pipeline run
# (first: arxiv-paper, all seven arms, claude-sonnet-5, 2026-08-12).
#
# Superseded results moved aside locally (e.g. measured with an older model)
# stay out of the repository.
results/archive/

# Node
web/node_modules/
web/.next/
web/out/
# Replay bundles: the committed results with the delta streams and the fields the
# charts already summarize stripped out. Written by scripts/build-replay.mjs on every
# build, so committing them would only be a second copy to keep in sync.
web/public/replay/
web/next-env.d.ts
web/.vercel/
web/tsconfig.tsbuildinfo

# Local env. Both keys live here; nothing in the repo reads a key from anywhere
# else, and no key should ever reach a committed file.
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
