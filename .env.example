# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Only the offline pipeline reads these. The site needs no keys at all: it is a
# static export of committed measurements, with no request-time code that could
# spend anything.
#
# On this branch the pipeline runs from the terminal only. The in-browser run flow
# lives on `main`, which is where to work if you want it.

# Required. Used by every arm, the contextual-prefix indexing pass, and the judge.
ANTHROPIC_API_KEY=sk-ant-...

# Alternative to the above, for an OAuth token from `ant auth print-credentials
# --access-token` rather than a static key. If both are set the API rejects the
# request, so set exactly one.
# ANTHROPIC_AUTH_TOKEN=

# Required for arms 3 and 4 only: embeddings and reranking. Anthropic has no
# embeddings API, so this is a separate dependency. Costs pennies at this scale.
VOYAGE_API_KEY=pa-...
